{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
	}
}

{$GEOCODER_DOMAIN} {
	@preflight {
		method OPTIONS
		path /reverse /reverse/ /search /search/
	}
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Access-Control-Allow-Headers "Accept, Accept-Language, Content-Type"
		respond "" 204
	}

	@geocoder path /reverse /reverse/ /search /search/
	handle @geocoder {
		header {
			Access-Control-Allow-Origin "*"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
		}
		rate_limit {
			zone geocoder {
				key {client_ip}
				events {$RATE_LIMIT_EVENTS:120}
				window {$RATE_LIMIT_WINDOW:1m}
				burst {$RATE_LIMIT_BURST:20}
				ipv6_prefix 64
			}
		}
		reverse_proxy nominatim:8080
	}

	handle /health {
		rewrite * /status
		reverse_proxy nominatim:8080
	}

	handle {
		respond "Not Found" 404
	}

	log {
		output stdout
		format json
	}
}
